596   003642:166700 003644:004446           sub     SYSSRC, r0
597   003646:042700 003650:177774           bic     #M3, r0                 ; posted
598   003652:010046           mov     r0, -(sp)
599   003654:012700 003656:000141           mov     #A_BUFS+1, r0
600   003660:004767 003662:175372           jsr     pc, MEMRD               ; receiver
601   003664:166700 003666:004424           sub     SYSSRC, r0
602   003670:042700 003672:177774           bic     #M3, r0                 ; taken
603   003674:001415           beq     P3X1
604   003676:020066 003700:000000           cmp     r0, 0(sp)
605   003702:101012           bhi     P3X1                    ; taken > posted: not yet
606   003704:005726           tst     (sp)+
607   003706:005067 003710:004376           clr     SYSB
608   003712:016704 003714:004374           mov     SYSLN, r4
609   003716:010405           mov     r4, r5
610   003720:006305           asl     r5
611   003722:005065 003724:010000           clr     TERM(r5)                ; the terminal is released
612   003726:000207           rts     pc
613   003730:005726   P3X1:   tst     (sp)+
614   003732:000207   P3X:    rts     pc
616                           ; ---- PROCESS: one pass of the state machine ----
618                           PROCESS:
619   003734:032737 003736:000400 003740:160540           bit     #400, @#CSR             ; LC: the lines have changed
620   003742:001402           beq     PR0
621   003744:004767 003746:175744           jsr     pc, LSTATH
622   003750:032737 003752:000200 003754:160540   PR0:    bit     #200, @#CSR             ; RR: the FIFO has characters
623   003756:001405           beq     PR1
624   003760:013700 003762:160542           mov     @#RBUF, r0              ; pops the FIFO
625   003764:004767 003766:175466           jsr     pc, RXTAKE
626   003770:000767           br      PR0
627   003772:004767 003774:177310   PR1:    jsr     pc, DRAIN
628   003776:004767 004000:177620           jsr     pc, PROC3
629   004002:012704 004004:000001           mov     #1, r4
630   004006:010405   PL:     mov     r4, r5
631   004010:006305           asl     r5
632   004012:005767 004014:004272           tst     SYSB
633   004016:001051           bne     PCOM
634   004020:016500 004022:010144           mov     ST(r5), r0
635   004024:032700 004026:000020           bit     #WANTD, r0
636   004030:001413           beq     PTRYC
637   004032:042765 004034:000020 004036:010144           bic     #WANTD, ST(r5)          ; disconnect: no reply is sent
638   004040:005765 004042:010000           tst     TERM(r5)
639   004044:001472           beq     PNEXT
640   004046:012700 004050:000003           mov     #3, r0
641   004052:004767 004054:176636           jsr     pc, SYREQ
642   004056:000465           br      PNEXT
643   004060:032700 004062:000010   PTRYC:  bit     #WANTC, r0
644   004064:001426           beq     PCOM
645   004066:042765 004070:000010 004072:010144           bic     #WANTC, ST(r5)
646   004074:004767 004076:176504           jsr     pc, STARTL
647   004100:052765 004102:000004 004104:010144           bis     #UP, ST(r5)
648   004106:012700 004110:000001           mov     #1, r0
649   004112:004767 004114:176576           jsr     pc, SYREQ
650   004116:005767 004120:004166           tst     SYSB
651   004122:001043           bne     PNEXT                   ; posted: the reply will come
652   004124:042765 004126:000004 004130:010144           bic     #UP, ST(r5)             ; ring full: revert, try again
653   004132:052765 004134:000010 004136:010144           bis     #WANTC, ST(r5)
654   004140:000434           br      PNEXT
655   004142:005765 004144:010000   PCOM:   tst     TERM(r5)
656   004146:001431           beq     PNEXT
657   004150:004767 004152:176006           jsr     pc, CHKACK
658   004154:005765 004156:010062           tst     PEND(r5)
659   004160:001024           bne     PNEXT                   ; the ОС has not taken the event yet
660   004162:016500 004164:010144           mov     ST(r5), r0
661   004166:032700 004170:000002           bit     #OUTDN, r0
662   004172:001412           beq     PTRYI
663   004174:012700 004176:000005           mov     #5, r0                  ; output done: post 5
664   004200:004767 004202:176052           jsr     pc, POSTEV
665   004204:005700           tst     r0
666   004206:001411           beq     PNEXT
667   004210:042765 004212:000002 004214:010144           bic     #OUTDN, ST(r5)
668   004216:000405           br      PNEXT
669   004220:032700 004222:000001   PTRYI:  bit     #READY, r0
670   004224:001402           beq     PNEXT
671   004226:004767 004230:176162           jsr     pc, PASSIN              ; the finished line: post 4
672   004232:005204   PNEXT:  inc     r4
673   004234:020427 004236:000030           cmp     r4, #24.
674   004240:003662           ble     PL
