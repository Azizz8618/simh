357   002354:005700           tst     r0
358   002356:001013           bne     PE2
359   002360:005065 002362:010062           clr     PEND(r5)                ; ring full: undo
360   002364:004767 002366:177554           jsr     pc, AREAO
361   002370:062700 002372:000002           add     #2, r0                  ; CMD_IN <- 0 again
362   002374:005001           clr     r1
