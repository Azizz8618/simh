407   002570:005065 002572:010226           clr     LEN(r5)
408   002574:042765 002576:000001 002600:010144           bic     #READY, ST(r5)
409   002602:000207   PID:    rts     pc
411                           ; ---- start_line: fresh header of the area (port of start_line) ----
413   002604:004767 002606:177334   STARTL: jsr     pc, AREAO
414   002610:052700 002612:100000           bis     #AI, r0
415   002614:010037 002616:160550           mov     r0, @#KADDR
416   002620:005037 002622:160552           clr     @#KDATA                 ; +0
417   002624:005037 002626:160552           clr     @#KDATA                 ; +1
418   002630:005037 002632:160552           clr     @#KDATA                 ; +2
419   002634:010401           mov     r4, r1                  ; INBUF again (starts in bytes)
420   002636:070127 002640:001400           mul     #AREAS, r1              ; r1 is odd: the low word
421   002642:062701 002644:002210           add     #AREAB+AREAIN, r1
422   002646:006301           asl     r1
423   002650:010137 002652:160552           mov     r1, @#KDATA             ; +3
424   002654:005037 002656:160552           clr     @#KDATA                 ; +4
425   002660:005037 002662:160552           clr     @#KDATA                 ; +5
426   002664:005037 002666:160552           clr     @#KDATA                 ; +6
427   002670:005037 002672:160552           clr     @#KDATA                 ; +7
428   002674:005065 002676:010226           clr     LEN(r5)
429   002700:005065 002702:010062           clr     PEND(r5)
430   002704:042765 002706:000003 002710:010144           bic     #READY+OUTDN, ST(r5)
431   002712:000207           rts     pc
433                           ; ---- post_sys_request (line R4/R5, code 1 or 3 in R0) ----
435   002714:010002   SYREQ:  mov     r0, r2                  ; R2 = code
436   002716:004767 002720:177222           jsr     pc, AREAO               ; R1 = AREA(n) (AREAO returns it in r1)
437   002722:010146           mov     r1, -(sp)               ; area, for АБФОСS+2 (byte address)
438   002724:012700 002726:000154           mov     #A_FOSS, r0             ; code
439   002730:010201           mov     r2, r1
440   002732:004767 002734:176332           jsr     pc, MEMWR
441   002736:012700 002740:000155           mov     #A_FOSS+1, r0           ; code 1: the line, else the terminal
442   002742:022702 002744:000001           cmp     #1, r2
443   002746:001002           bne     SR1
444   002750:010401           mov     r4, r1
445   002752:000402           br      SR2
446   002754:016501 002756:010000   SR1:    mov     TERM(r5), r1
447   002760:004767 002762:176304   SR2:    jsr     pc, MEMWR
448   002764:022702 002766:000001           cmp     #1, r2                  ; code 1: the byte address of the area
449   002770:001004           bne     SR3
450   002772:016601 002774:000000           mov     0(sp), r1
451   002776:006301           asl     r1
452   003000:000401           br      SR4
453   003002:005001   SR3:    clr     r1
454   003004:012700 003006:000156   SR4:    mov     #A_FOSS+2, r0
455   003010:004767 003012:176254           jsr     pc, MEMWR
456   003014:012700 003016:000140           mov     #A_BUFS, r0             ; sys_src = the source at posting time
457   003020:004767 003022:176232           jsr     pc, MEMRD
458   003024:042700 003026:177774           bic     #M3, r0
459   003030:010067 003032:005260           mov     r0, SYSSRC
460   003034:010246           mov     r2, -(sp)               ; the code: POST uses r2 for the abonent
461   003036:012700 003040:000060           mov     #ABNOS, r0              ; abonent 48 = the ОС
462   003042:004767 003044:176244           jsr     pc, POST
463   003046:012602           mov     (sp)+, r2               ; the code back (POST clobbered r2)
464   003050:005726           tst     (sp)+                   ; the area off the stack
465   003052:005700           tst     r0
466   003054:001404           beq     SRX                     ; ring full: not busy, retry later
467   003056:010267 003060:005226           mov     r2, SYSB
