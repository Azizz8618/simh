588   003620:000207   DRX:    rts     pc
590                           ; ---- disconnect completion: the ОС has read the ring (sys_busy = 3) ----
592   003622:022767 003624:000003 003626:004460   PROC3:  cmp     #3, SYSB
593   003630:001040           bne     P3X
594   003632:012700 003634:000140           mov     #A_BUFS, r0
