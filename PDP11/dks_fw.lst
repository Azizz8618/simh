369                           ; ---- pass_input: the typed line into the area, post 4 ----
371   002414:004767 002416:177524   PASSIN: jsr     pc, AREAO
372   002420:062700 002422:001210           add     #AREAIN, r0             ; the word address of the buffer
373   002424:052700 002426:100000           bis     #AI, r0
374   002430:010037 002432:160550           mov     r0, @#KADDR             ; auto-increment over the buffer
375   002434:005002           clr     r2                      ; R2 = i, byte counter (from 0)
