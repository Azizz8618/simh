469   003066:000207   SRX:    rts     pc
471                           ; ---- take_output: the output array to the terminal (line R4/R5) ----
473                           TAKEOUT:
474   003070:004767 003072:177050           jsr     pc, AREAO
475   003074:010046           mov     r0, -(sp)               ; area saved
476   003076:010001           mov     r0, r1
477   003100:062700 003102:000005           add     #5, r0                  ; CMD_OUT
478   003104:004767 003106:176146           jsr     pc, MEMRD
479   003110:022700 003112:000004           cmp     #4, r0                  ; 4 or 5: take an array
480   003114:001404           beq     TO1
481   003116:022700 003120:000005           cmp     #5, r0
482   003122:001401           beq     TO1
483   003124:000466           br      TOX
484   003126:016601 003130:000000   TO1:    mov     0(sp), r1
485   003132:010100           mov     r1, r0
486   003134:062700 003136:000006           add     #6, r0                  ; OUTADDR (byte address)
487   003140:004767 003142:176112           jsr     pc, MEMRD
488   003144:006200           asr     r0                      ; -> word address
489   003146:010002           mov     r0, r2                  ; R2 = source
490   003150:010100           mov     r1, r0
491   003152:062700 003154:000007           add     #7, r0                  ; OUTLEN
492   003156:004767 003160:176074           jsr     pc, MEMRD
493   003162:010003           mov     r0, r3                  ; R3 = length in words
494   003164:016601 003166:000000           mov     0(sp), r1
495   003170:010100           mov     r1, r0
496   003172:062700 003174:000005           add     #5, r0                  ; CMD_OUT <- 0 (taken)
497   003176:005001           clr     r1
498   003200:004767 003202:176064           jsr     pc, MEMWR
499   003204:010437 003206:160544           mov     r4, @#TSEL              ; the line, once
500   003210:005703   TO2:    tst     r3
501   003212:003430           ble     TO3
502   003214:010200           mov     r2, r0
503   003216:004767 003220:176034           jsr     pc, MEMRD               ; the word of the array
504   003222:010001           mov     r0, r1
505   003224:032700 003226:000377           bit     #377, r0                ; low byte == 0: end
506   003230:001421           beq     TO3
507   003232:010100           mov     r1, r0
508   003234:042700 003236:177600           bic     #M7, r0
509   003240:010037 003242:160546           mov     r0, @#TBUF              ; low character
510   003244:010100           mov     r1, r0
