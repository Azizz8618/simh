518   003272:000746           br      TO2
519   003274:052765 003276:000002 003300:010144   TO3:    bis     #OUTDN, ST(r5)          ; completion follows as command 5
520   003302:005726   TOX:    tst     (sp)+
521   003304:000207           rts     pc
523                           ; ---- drain_bufh: the entries the ОС posted + the connect reply ----
525   003306:012700 003310:000146   DRAIN:  mov     #A_BUFH, r0
526   003312:004767 003314:175740           jsr     pc, MEMRD               ; source (the ОС side)
527   003316:010001           mov     r0, r1
528   003320:016702 003322:004772           mov     BHR, r2                 ; our receiver
529   003324:020201   DR0:    cmp     r2, r1
530   003326:001446           beq     DRSY
531   003330:010200           mov     r2, r0
532   003332:062700 003334:000150           add     #A_BUFH+2, r0
533   003336:004767 003340:175714           jsr     pc, MEMRD               ; the abonent from the slot
534   003342:010046           mov     r0, -(sp)               ; abonent saved
535   003344:005202           inc     r2
536   003346:042702 003350:177774           bic     #M3, r2
537   003352:010267 003354:004740           mov     r2, BHR
538   003356:010201           mov     r2, r1
539   003360:012700 003362:000147           mov     #A_BUFH+1, r0
540   003364:004767 003366:175700           jsr     pc, MEMWR               ; receiver <- our count
541   003370:012600           mov     (sp)+, r0
542   003372:001414           beq     DR1                     ; abonent 0: not a line
543   003374:020027 003376:000030           cmp     r0, #24.                ; r0 > 24 (unsigned): the ОС, etc.
544   003400:101011           bhi     DR1
545   003402:010004           mov     r0, r4                  ; line abonent: print the array
546   003404:010405           mov     r4, r5
547   003406:006305           asl     r5
548   003410:032765 003412:000004 003414:010144           bit     #UP, ST(r5)             ; find_line: the line must be up
549   003416:001402           beq     DR1
550   003420:004767 003422:177444           jsr     pc, TAKEOUT
551   003424:012700 003426:000146   DR1:    mov     #A_BUFH, r0             ; the ОС may have added entries
552   003430:004767 003432:175622           jsr     pc, MEMRD
553   003434:010001           mov     r0, r1
554   003436:016702 003440:004654           mov     BHR, r2
555   003442:000730           br      DR0
556   003444:022767 003446:000001 003450:004636   DRSY:   cmp     #1, SYSB                ; waiting for the connect reply?
557   003452:001062           bne     DRX
558   003454:012700 003456:000157           mov     #A_FOSH, r0
559   003460:004767 003462:175572           jsr     pc, MEMRD
560   003464:022700 003466:000002           cmp     #2, r0                  ; +0 == 2: the reply is complete
561   003470:001053           bne     DRX
562   003472:012700 003474:000160           mov     #A_FOSH+1, r0
563   003476:004767 003500:175554           jsr     pc, MEMRD
564   003502:010002           mov     r0, r2                  ; terminal
565   003504:012700 003506:000161           mov     #A_FOSH+2, r0
566   003510:004767 003512:175542           jsr     pc, MEMRD
567   003514:010003           mov     r0, r3                  ; result
568   003516:005001           clr     r1
569   003520:012700 003522:000157           mov     #A_FOSH, r0
570   003524:004767 003526:175540           jsr     pc, MEMWR               ; the reply is consumed
571   003530:005067 003532:004554           clr     SYSB
572   003534:016704 003536:004552           mov     SYSLN, r4
573   003540:010405           mov     r4, r5
574   003542:006305           asl     r5
575   003544:005703           tst     r3
576   003546:001003           bne     DRErr
577   003550:010265 003552:010000           mov     r2, TERM(r5)            ; success: the terminal is ours
578   003554:000421           br      DRX
579   003556:016701 003560:004530   DRErr:  mov     SYSLN, r1               ; the ОС refused
580   003562:022703 003564:000001           cmp     #1, r3
581   003566:001405           beq     DRE1
582   003570:012700 003572:010350           mov     #MNOTERM, r0
583   003574:004767 003576:175636           jsr     pc, SENDS
584   003600:000404           br      DRE2
585   003602:012700 003604:010324   DRE1:   mov     #MBUSY, r0
