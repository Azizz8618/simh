348   002316:004767 002320:176734           jsr     pc, MEMRD
349   002322:052700 002324:020000           bis     #FLAG, r0
350   002326:010046           mov     r0, -(sp)
351   002330:010100           mov     r1, r0
352   002332:016601 002334:000000           mov     0(sp), r1
