378   002444:005003           clr     r3                      ; lo = (i < len) ? buf[i] : 0
379   002446:020265 002450:010226           cmp     r2, LEN(r5)
380   002452:002011           bge     PI4
381   002454:010401           mov     r4, r1
382   002456:070127 002460:000360           mul     #240., r1               ; r1 is odd: the low word
383   002462:062701 002464:010022           add     #LBUF-240., r1
384   002466:060201           add     r2, r1
385   002470:111103           movb    (r1), r3
386   002472:042703 002474:177400           bic     #M8, r3
387   002476:016500 002500:010226   PI4:    mov     LEN(r5), r0             ; hi = (i+1 < len) ? buf[i+1] : 0
388   002502:160200           sub     r2, r0                  ; len - i
389   002504:020027 002506:000002           cmp     r0, #2
390   002510:002414           blt     PI5
391   002512:010401           mov     r4, r1
392   002514:070127 002516:000360           mul     #240., r1               ; r1 is odd: the low word
393   002520:062701 002522:010022           add     #LBUF-240., r1
394   002524:060201           add     r2, r1
395   002526:005201           inc     r1                      ; + i + 1
396   002530:111101           movb    (r1), r1
397   002532:042701 002534:177400           bic     #M8, r1
398   002536:000301           swab    r1                      ; the byte goes to bits 8-15
399   002540:050103           bis     r1, r3                  ; word = lo | hi << 8
400   002542:010337 002544:160552   PI5:    mov     r3, @#KDATA             ; one word per access (AI advances)
401   002546:062702 002550:000002           add     #2, r2
402   002552:000731           br      PI1
