331   002246:001002           bne     CKD
332   002250:005065 002252:010062           clr     PEND(r5)
333   002254:000207   CKD:    rts     pc
335                           ; ---- post_line_event (line R4/R5, command in R0 -> R0 = 1 posted) ----
337   002256:010003   POSTEV: mov     r0, r3                  ; R3 = command
338   002260:004767 002262:177660           jsr     pc, AREAO
339   002264:010001           mov     r0, r1                  ; R1 = area
