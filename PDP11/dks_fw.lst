341   002272:010100           mov     r1, r0
342   002274:062700 002276:000002           add     #2, r0                  ; CMD_IN
343   002300:010301           mov     r3, r1
344   002302:004767 002304:176762           jsr     pc, MEMWR
345   002306:022703 002310:000004           cmp     #4, r3
346   002312:001014           bne     PE1
