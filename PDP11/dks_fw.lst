№стр  адрес   слова            исходный текст
1                             ; dks_fw.mac - firmware of the ДКС terminal concentrator, stage B1.
2                             ;
3                             ; The СВЯЗЬ7 protocol engine of the Э-60, ported 1:1 from the C engine of
4                             ; PDP11/pdp11_dks.c (dks_process, drain_bufh, dks_line_char and friends),
5                             ; which in turn follows the reference BESM6/besm6_dks.c tables.
6                             ; Assembled by PDP11/tests/gen_dks_fw.py ("листинговая сборка") into the
7                             ; absolute-loader image PDP11/dks_fw.bin:
8                             ;
9                             ;       load PDP11/dks_fw.bin           ; code at 01000, vectors at 0300/0304
10                            ;       go                              ; PC comes from the end block
11                            ;
12                            ; The device is set to SET DKS ENGINE=HOST, VECTOR=300, ADDRESS=17760540
13                            ; (the register addresses below assume exactly that; autoconfiguration
14                            ; must not move it).  The 32K-word ОЗУ of the Э-60 lives inside the
15                            ; device (e60_mem) and is reached through the KADDR/KDATA window - the
16                            ; same way КАДОПАМ reaches it in the real machine.  Everything the
17                            ; engine writes there (rings, terminal areas) is exactly what the ОС
18                            ; sees over the КАДОПАМ bridge.
19                            ;
20                            ; Structure (event-driven, single-threaded - no data races):
21                            ;
22                            ;       MAIN:   PROCESS; WAIT; repeat
23                            ;
24                            ; The interrupt handlers do nothing but wake the WAIT (both are RTI):
25                            ; DKSRX fires while the received-data FIFO is non-empty, DKSATN on a
26                            ; doorbell from the БЭСМ-6 (cell 077777 = 0400) or on a line state
27                            ; change (LC).  PROCESS drains the FIFO, reacts to the line state and
28                            ; runs the protocol state machine once per wake-up - the same "polled"
29                            ; structure as the C engine, so the two stay 1:1 comparable.
30                            ;
31                            ; Subroutine convention (all subroutines keep R4/R5, clobber R0-R3):
32                            ;       R4 = line number 1..24, R5 = its word index (R4 << 1)
33                            ;
34                            ; Requires EIS (MUL) - the Э-60 CPU (1801ВМ2) has it.  SOB is avoided
35                            ; (the LSI-11 instruction set does not have it).
37                            ; ---- Unibus registers: 22-bit 17760540 = kernel 0160540 ----
39                            CSR     = 160540                        ; control/status
40                            RBUF    = 160542                        ; received: line<<8|char, DV 040000
41                            TSEL    = 160544                        ; transmit line select
42                            TBUF    = 160546                        ; transmit buffer
43                            KADDR   = 160550                        ; ОЗУ window address; 0100000 = AI
44                            KDATA   = 160552                        ; ОЗУ window data
45                            KCTL    = 160554                        ; bits 0-2 channel, 0400 signal БЭСМ-6
46                            LST0    = 160556                        ; telnet lines 1..12 connected
47                            LST1    = 160560                        ; telnet lines 13..24 connected
49                            ; ---- СВЯЗЬ7 constants (PDP11/pdp11_dks.h, octal word addresses) ----
51                            A_BUFS  = 140                           ; ring Э-60 -> БЭСМ-6
52                            A_BUFH  = 146                           ; ring БЭСМ-6 -> Э-60
53                            A_FOSS  = 154                           ; system request
54                            A_FOSH  = 157                           ; system reply
55                            AREAB   = 1000                          ; base of the terminal areas
56                            AREAS   = 1400                          ; area stride
57                            AREAIN  = 1210                          ; input buffer word offset in an area
58                            ABNOS   = 60                            ; abonent 48 (decimal) = the ОС
59                            CHAN2   = 2                             ; КРК channel of the window (DKS_CHAN)
60                            AI      = 100000                        ; KADDR auto-increment bit
61                            FLAG    = 20000                         ; area status flag 020000
62                            SIGNAL  = 400                           ; KCTL: "signal БЭСМ-6" (ПРП6)
63                            M3      = 177774                        ; ~3: keep the low 2 bits (ring mask)
64                            M37     = 177740                        ; ~037: keep 5 bits (line 1..24)
65                            M8      = 177400                        ; ~0377: keep the low byte
66                            M7      = 177600                        ; ~0177: KOI-7 (7-bit) characters
67                            MFLAG   = 157600                        ; ~FLAG, for BIC
69                            ; ---- per-line state bits (ST table) ----
71                            READY   = 1                             ; the line finished a line, not sent
72                            OUTDN   = 2                             ; output printed, completion not sent
73                            UP      = 4                             ; the ОС has assigned a terminal
74                            WANTC   = 10                            ; telnet connect not yet requested
75                            WANTD   = 20                            ; telnet drop not yet requested
77                            ; ---- interrupt vectors ----
78                            ; The CPU traps (4, 10, 14, 24, 34) point at a HALT: an unexpected trap
79                            ; stops the machine cleanly instead of running wild.  Everything else
80                            ; that could interrupt (CLK, PTR, PTP, LPT, RHA, RK, DZ) is disabled in
81                            ; the INI, so the DKSRX/DKSATN vectors at 0300/0304 are the only live
82                            ; ones.
84                                    .ASECT
85                                    .=4
86    000004:004246 000006:000340           .WORD   DEAD4, 340              ; odd address / timeout
87                                    .=10
88    000010:004250 000012:000340           .WORD   DEAD10, 340             ; reserved instruction
89                                    .=14
90    000014:004252 000016:000340           .WORD   DEAD14, 340             ; BPT
91                                    .=24
92    000024:004254 000026:000340           .WORD   DEAD24, 340             ; IOT / EMT
93                                    .=34
94    000034:004256 000036:000340           .WORD   DEAD34, 340             ; TRAP / CALL
95                                    .=300
96    000300:004244 000302:000200           .WORD   IRET, 200               ; 0300 DKSRX: wake-up only
97    000304:004244 000306:000200           .WORD   IRET, 200               ; 0304 DKSATN: wake-up only
