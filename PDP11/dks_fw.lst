325   002222:022701 002224:000005   CK1:    cmp     #5, r1
326   002226:001012           bne     CKD
327   002230:004767 002232:177710           jsr     pc, AREAO               ; STATUS1 flag gone?
328   002234:005200           inc     r0
329   002236:004767 002240:177014           jsr     pc, MEMRD
