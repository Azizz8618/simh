;
; Allowing telnet connections: Э-60 (ДКС) lines for terminals 2-24.
; Slot is pinned with Line=N so that slot N = unit ttyN. tty2 takes
; port 4199 — the game terminal of the ДИСПАК command «ИГРА 4199»;
; tty3..tty24 take 4202..4223 (tty3/4202 — the default in ie15.conf).
; ДИСПАК numbers terminals of the group by connect order
; (see besm6_dks.c, «set ttyN dks»). NB: `detach ttyN` tears down the
; whole mux — restart the guest instead of re-attaching single lines.
;
set dks enabled
set tty2 authbs
attach tty2 Line=2,4199
set tty2 authbs,raw
;set tty2 dks,raw
attach tty3 Line=3,4202
set tty3 dks,raw
attach tty4 Line=4,4203
set tty4 dks,raw
attach tty5 Line=5,4204
set tty5 dks,raw
attach tty6 Line=6,4205
set tty6 dks,raw
attach tty7 Line=7,4206
set tty7 dks,raw
attach tty8 Line=8,4207
set tty8 dks,raw
