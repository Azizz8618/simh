# .clinerules — Оптимизация работы Cline для проекта БЭСМ-6
# Версия: 2026-08-27
# Наследует: ~/.clinerules
# Цель: Сократить расход токенов на 30-40%

## === РЕЗЕРВНОЕ КОПИРОВАНИЕ ===

# Автозапуск при старте сессии:
# ~/Yandex.Disk/cline_backups/cline_backup.sh

# Файлы проекта для бэкапа:
# - .clinerules (этот файл)
# - AGENTS.md
# - TEAM_AGENTS.md  
# - GENS_AGENTS.md

# Быстрая проверка изменений:
# grep "$PWD/.clinerules" ~/Yandex.Disk/cline_backups/cache/hashes.md5

## === СТРАТЕГИЯ РАБОТЫ С ФАЙЛАМИ ===

# Правило 1: Пакетное чтение
# Всегда читать все нужные файлы за один вызов read_files
# Плохо:  read_files: [besm6_cpu.c], read_files: [besm6_tty.c]
# Хорошо: read_files: [besm6_cpu.c, besm6_tty.c, besm6_defs.h]

# Правило 2: Частичное чтение больших файлов
# Для файлов >1000 строк использовать start_line/end_line
# Пример: read_files: [{path: besm6_cpu.c, start_line: 100, end_line: 200}]

# Правило 3: Не перечитывать без необходимости
# Если файл не менялся, не читать его повторно

## === СТРАТЕГИЯ КОМАНД ===

# Правило 4: Параллельные команды
# Группировать независимые команды в один run_commands
# Плохо:  run_commands: ["ls"], run_commands: ["pwd"]
# Хорошо: run_commands: ["ls && pwd"]

# Правило 5: Фоновый режим для долгих операций
# Долгие команды: make, gcc, npm install, docker build
# Синтаксис: make > /tmp/build.log 2>&1 &
# Проверка: tail -20 /tmp/build.log

# Правило 6: Ограничение вывода
# Всегда использовать head/tail для больших выводов
# Плохо:  cat log.txt
# Хорошо: tail -50 log.txt

## === КЭШ ФАЙЛОВ СЕССИИ ===

# КРИТИЧЕСКИ ВАЖНО для экономии токенов!
#
# После первого чтения файла:
# 1. Запомнить: "Файл X прочитан, N строк"
# 2. При повторном обращении: НЕ вызывать read_files
# 3. Ссылаться на уже известные фрагменты по номерам строк
#
# Пример правильной работы:
#   Шаг 1: read_files: [besm6_tty.c] → прочитан ~1500 строк
#   Шаг 2: "Как мы видели в строках 270-290, функция dks_poll..."
#          → НЕ вызывать read_files снова!
#
# Пример НЕправильной работы (потеря токенов):
#   Шаг 1: read_files: [besm6_tty.c] → 8,000 токенов
#   Шаг 2: read_files: [{besm6_tty.c, lines 270-290}] → 1,000 токенов
#   Шаг 3: read_files: [{besm6_tty.c, lines 400-450}] → 1,500 токенов
#   Потеря: 2,500 токенов на повторные чтения
#
# Правило: ОДНО чтение файла на сессию!

## === ДИАГНОСТИКА ТОЛЬКО ПРИ НЕОБХОДИМОСТИ ===

# НЕ вызывать:
# - ls после создания файла (и так понятно, что он создан)
# - wc -l после записи (известен размер из содержимого)
# - diff между идентичными файлами (проверка избыточна)
# - head/tail файла, который только что записан
# - cat для просмотра только что записанного содержимого
#
# Вызывать только:
# - При сомнениях в результате операции
# - При ошибках компиляции/выполнения
# - Для поиска в неизвестных файлах

## === БАТЧЕВАЯ ВЕРИФИКАЦИЯ ===

# Вместо проверки после каждого действия:
#   Плохо:
#     1. edit file1.c
#     2. ls file1.c          ← избыточно
#     3. edit file2.c
#     4. head file2.c        ← избыточно
#     5. edit file3.c
#     6. wc -l file3.c       ← избыточно
#
#   Хорошо:
#     1. edit file1.c
#     2. edit file2.c
#     3. edit file3.c
#     4. Единственная проверка: make > /tmp/build.log 2>&1 && tail /tmp/build.log

## === ИНКРЕМЕНТАЛЬНОЕ РЕДАКТИРОВАНИЕ БОЛЬШИХ ФАЙЛОВ ===

# Проблема: editor не принимает old_text > 6000 символов
#
# Решение 1: sed для точечных замен
#   sed -i 's/старый_текст/новый_текст/' file.be
#
# Решение 2: Удаление/вставка строк
#   sed -i '50,60d' file.be           # удалить строки 50-60
#   sed -i '49a\новая строка' file.be # вставить после строки 49
#
# Решение 3: Многоэтапная запись через heredoc
#   cat > file.be << 'PART1'
#   [часть 1 - заголовок]
#   PART1
#   cat >> file.be << 'PART2'
#   [часть 2 - тело]
#   PART2
#   cat >> file.be << 'PART3'
#   [часть 3 - хвост]
#   PART3

## === СТРАТЕГИЯ ПОИСКА ===

# Правило 7: Кэширование результатов поиска
# Сохранять: grep -n "pattern" file > /tmp/search_pattern.txt
# Повторять: cat /tmp/search_pattern.txt

# Правило 8: Специфичные паттерны
# Использовать точные имена функций/переменных
# Плохо:  grep -r "dks" .
# Хорошо: grep -n "dks_poll" besm6_tty.c

## === МИНИМИЗАЦИЯ ОТЛАДКИ ===

# Правило 9: Убрать декоративные команды
# Не использовать: echo "=== Section ===", printf "----"
# Не проверять файлы ls/stat без необходимости

# Правило 10: Только существенные проверки
# Проверять файлы только если есть сомнения в результате

## === ПРОЕКТ-СПЕЦИФИЧНЫЕ ПРАВИЛА ===

# Пути проекта
PROJECT_ROOT = /home/azizz/Yandex.Disk/simh/BESM6
BUILD_LOG    = /tmp/besm6_build.log
DEBUG_LOG    = debug.txt

# Ключевые файлы (не читать полностью без нужды — использовать карты)
# Карты: .cline/maps/<файл>.map (~2k токенов вместо ~27k)
LARGE_FILES:
  - besm6_cpu.c    (~2105 строк → besm6_cpu.c.map)
  - besm6_tty.c    (~1709 строк → besm6_tty.c.map)
  - besm6_mmu.c    (~765 строк  → besm6_mmu.c.map)
  - besm6_disk.c   (~1001 строк → besm6_disk.c.map)
  - besm6_defs.h   (~510 строк  → besm6_defs.h.map)

# Известные константы
KADOPAM_BASE = 0x2000
KADOPAM_SIZE = 0x100
GRP_SLAVE    = 04000000000000000000000ULL

# Команды проекта
BUILD_CMD   = cd /home/azizz/Yandex.Disk/simh && make besm6 > /tmp/besm6_build.log 2>&1
# ВАЖНО: сборка ТОЛЬКО из папки simh (make besm6), после КАЖДОЙ правки
# исходников; make из папки BESM6 НЕ пересобирает эмулятор.
CHECK_CMD   = tail -20 /tmp/besm6_build.log
RUN_CMD     = ./BIN/besm6 dispak.ini
DEBUG_CMD   = tail -f debug.txt | grep -iE "(DKS|KDP|PRP)"

## === КАРТЫ КОДА (CONTEXT COMPRESSION) ===

# Навык: .cline/skills/code-map.md
# Карты: .cline/maps/<имя_файла>.map

# Правило M1: Карта — ПЕРВИЧНЫЙ источник (АВТОМАТИЧЕСКИ)
# При любом обращении к файлу из LARGE_FILES ВСЕГДА читать карту:
#   read_files: [.cline/maps/<файл>.map]   ← 2k токенов
# Полное чтение файла ЗАПРЕЩЕНО, пока карта не прочитана.
# Это правило применяется АВТОМАТИЧЕСКИ — без триггеров, без напоминаний.

# Правило M2: Навигация через карту (АВТОМАТИЧЕСКИ)
# Для поиска функции/переменной/константы:
#   1. Прочитать .cline/maps/<файл>.map
#   2. Найти нужный символ в таблице функций/переменных
#   3. Получить диапазон строк
#   4. Полное чтение — ТОЛЬКО нужного диапазона (start_line/end_line)
# Плохо:  read_files: [besm6_cpu.c]                    ← 27k токенов
# Хорошо: read_files: [.cline/maps/besm6_cpu.c.map]     ← 2k токенов
#         затем read_files: [{besm6_cpu.c, 971, 1019}]  ← 1k токенов (write_032)

# Правило M3: Полное чтение — ТОЛЬКО исключения
# Полный файл читается ТОЛЬКО если:
#   - Нужно редактировать несколько регионов в одном файле
#   - Требуется анализ, не сводимый к структуре (например, поиск логической ошибки)
# В этих случаях — сначала карта, потом полное чтение с обоснованием.

# Правило M4: Свежесть карты — АВТОМАТИЧЕСКАЯ регенерация
# Скрипт scripts/gen_code_map.sh вызывает awk-парсер scripts/gen_map.awk,
# который извлекает функции, переменные, #define, typedef из исходника.
#   ./scripts/gen_code_map.sh --check <файл>    (одна карта)
#   ./scripts/gen_code_map.sh --check           (все устаревшие)
#   ./scripts/gen_code_map.sh --all             (все карты)

# Правило M5: Автогенерация карт при старте сессии (АВТОМАТИЧЕСКИ)
# ВНАЧАЛЕ каждой сессии или задачи — ОБЯЗАТЕЛЬНО:
#   ./scripts/gen_code_map.sh --check
# Скрипт проверяет все карты и регенерирует устаревшие (~0.1 сек на карту).
# Это гарантирует актуальность карт без ручного шага.

# Правило M6: Автоматическое сжатие контекста (АВТОМАТИЧЕСКИ)
# При необходимости работы с файлом из LARGE_FILES:
#   1. ВСЕГДА читать .cline/maps/<файл>.map (~2k токенов) — НЕ полный файл
#   2. Полное чтение ЗАПРЕЩЕНО, кроме:
#      - Редактирование конкретного региона (start_line/end_line после карты)
#      - Карта не существует и файл < 500 строк
#   3. После правки исходника — повторно --check для актуализации карты
# Правило M6 применяется АВТОМАТИЧЕСКИ ко всем файлам из LARGE_FILES.

## === PROMPT CACHING (УРОВЕНЬ ПРОВАЙДЕРА) ===

# Провайдер кеширует идентичный ПРЕФИКС контекста.
# После первого вызова кешированная часть стоит ~10% полной цены.
# Экономия на повторяющемся системном контексте ~35k токенов.

# Канонический манифест контекста (кешируемый префикс)
# Загружать СТРОГО в этом порядке — изменение порядка = cache miss
CONTEXT_MANIFEST:
  1. .clinerules                          (правила проекта)
  2. AGENTS.md                             (инструкции агента)
  3. TEAM_AGENTS.md                        (координация агентов)
  4. GENS_AGENTS.md                       (генератор системы)
  5. .cline/skills/*.md                    (навыки, 8 файлов)
  6. .cline/maps/*.map                     (карты кода, 5 файлов)

# Правило P1: Канонический порядок
# Контекст загружается в порядке CONTEXT_MANIFEST — никогда не менять порядок.
# Любое переупорядочивание инвалидирует кеш → полная оплата 35k токенов.

# Правило P2: Стабильность префикса
# Кешируемый префикс должен быть СТАБИЛЬНЫМ между сессиями:
#   - Без временных меток (date, time, session-id)
#   - Без динамических значений (git status, mtimes, PID)
#   - Без результатов выполнения (логи, вывод команд)
# Эти данные — только в «хвосте» (после префикса).

# Правило P3: Волатильные данные — в хвост
# Динамическое содержимое размещать ТОЛЬКО после загрузки префикса:
#   - git log, git status
#   - ls, stat, date
#   - вывод make, test, эмулятора
#   - state эмулятора (debug.txt, логи ДКС)

# Правило P4: Карты кода — часть кеша
# .cline/maps/*.map стабильны между сессиями (регенерируются редко).
# Они входят в кешируемый префикс → экономия ~7k токенов на каждом вызове.

# Правило P5: Не инжектировать волатильное в префикс
# НЕ добавлять в .clinerules / AGENTS.md / skills / maps:
#   - Даты последнего обновления (кроме версионирования)
#   - Счётчики сессий
#   - Текущее состояние проекта
# Эти данные — в отдельных временных файлах или в хвосте контекста.

## === ОГРАНИЧЕНИЕ: МУЛЬТИ-МОДЕЛЬНЫЙ РОУТИНГ ===

# Архитектура Cline (team_spawn_teammate) НЕ поддерживает назначение
# разных LLM разным агентам. Все агенты (builder/coder/emulator/os-analyst)
# работают на одной модели. Модельный роутинг требует:
#   - Поддержки со стороны платформы (параметр модели на агента), ИЛИ
#   - Внешнего оркестратора, вызывающего разные API напрямую
# До реализации — оптимизация идёт через контекстное сжатие + кеширование,
# а не через дешёвые модели для простых задач.

## === ЧЕК-ЛИСТ ПЕРЕД КАЖДЫМ ВЫЗОВОМ ===

# === СТАРТ СЕССИИ (выполнить один раз) ===
# [ ] ./scripts/gen_code_map.sh --check  (автогенерация/актуализация карт — правило M5)

# === ПЕРЕД КАЖДЫМ read_files ===
# [ ] Файл из LARGE_FILES? → читать .cline/maps/<file>.map, НЕ полный файл (M1/M6)
# [ ] Файл уже читался в этой сессии? → Не читать снова
# [ ] Полное чтение крупного файла? → только start_line/end_line после карты (M2)

# === ПЕРЕД КАЖДЫМ run_commands ===
# [ ] Команда независима от других? → Группировать
# [ ] Команда выполняется >5 сек? → Запустить в фоне
# [ ] Вывод >50 строк? → Использовать head/tail
# [ ] Поиск уже выполнялся? → Проверить /tmp/search_*.txt
# [ ] Нужен ли этот echo? → Убрать декорации
# [ ] Волатильные данные в префиксе? → Перенести в хвост

# === ПОСЛЕ ПРАВКИ ИСХОДНИКА ===
# [ ] ./scripts/gen_code_map.sh --check <file>  (актуализировать карту — правило M6.3)

## === ШАБЛОНЫ ОПТИМИЗИРОВАННЫХ ВЫЗОВОВ ===

# Поиск и чтение:
#   grep -n "function_name" file.c > /tmp/func.txt && cat /tmp/func.txt
#   read_files: [{path: file.c, start_line: N-5, end_line: N+20}]

# Сборка:
#   make clean 2>/dev/null; make > /tmp/besm6_build.log 2>&1 &
#   sleep 3; tail -30 /tmp/besm6_build.log

# Отладка ДКС:
#   ./BIN/besm6 dispak.ini &
#   tail -f debug.txt | grep -iE "(DKS|terminal|PRP)"

## === УПРАВЛЕНИЕ КОНФИГУРАЦИОННЫМИ ФАЙЛАМИ И СКРИПТАМИ В GIT ===

# Правило: При создании или изменении конфигурационных файлов агента
# или скриптов они должны быть добавлены в индекс командой git add.
# Коммит делается ТОЛЬКО по команде РЗВ (резервная копия).

# Обязательные файлы:
# - .clinerules     — правила проекта
# - AGENTS.md       — инструкции для агента
# - TEAM_AGENTS.md  — координация агентов
# - GENS_AGENTS.md  — работа с ГЕНС

# Обязательные скрипты:
# - scripts/*.sh    — все создаваемые скрипты
# - scripts/*.awk   — awk-парсеры (gen_map.awk)
# - scripts/build.sh — фоновая сборка
# - scripts/test_dks.sh — тест ДКС
# - scripts/stop_emulator.sh — остановка эмулятора
# - scripts/monitor_dks.sh — мониторинг логов
# - scripts/search_code.sh — кэшированный поиск
# - scripts/gen_code_map.sh — автогенерация карт кода
# - scripts/gen_map.awk — awk-парсер C-файлов (вызывается gen_code_map.sh)

# Команда добавления файлов (выполнять сразу после изменения):
#   git add .clinerules AGENTS.md TEAM_AGENTS.md GENS_AGENTS.md

# Команда добавления скриптов (выполнять после создания скрипта):
#   git add scripts/*.sh scripts/*.awk

# Команда коммита (ТОЛЬКО по команде РЗВ):
#   git commit -m "Обновлены конфигурационные файлы и скрипты"

# Исключения (НЕ добавлять):
# - *.bak, *.bak.*  — резервные копии
# - *.swp, *.swo    — файлы vim
# - cline_config_*.tar.gz — архивы бэкапов
# - debug.txt, log.txt — временные логи
# - *.o, *.rez      — объектные файлы

## === АВТОМАТИЧЕСКИЙ РОУТИНГ ЗАДАЧ ===

# Агенты созданы через team_spawn_teammate:
# - builder: сборка, тестирование, логи
# - coder: точечные правки кода
# - emulator: ДКС, прерывания, команды процессора
# - os-analyst: модули ОС, трассы, СВЯЗЬ7

# Правило 11: Автоматическое делегирование
# При получении задачи анализировать ключевые слова и вызывать team_run_task

# Таблица роутинга:
# | Ключевые слова                          | Агент      |
# |----------------------------------------|------------|
# | собери, make, скомпилируй, build, gcc   | builder    |
# | исправь, добавь, измени, edit, fix      | coder      |
# | ДКС, ПРП, КАДОПАМ, прерывание, 032, 132 | emulator   |
# | СВЯЗЬ7, модуль ОС, трасса, зона, Диспак | os-analyst |

# Алгоритм:
# 1. Анализ входящей задачи на ключевые слова
# 2. Если есть совпадение → team_run_task(agentId, task, runMode: "sync")
# 3. Вернуть результат пользователю

# Примеры:
#   Пользователь: «собери проект»
#   → team_run_task(agentId: "builder", task: "Собери проект make > /tmp/build.log 2>&1 &")
#
#   Пользователь: «исправь dks_poll в besm6_tty.c»
#   → team_run_task(agentId: "coder", task: "Исправь функцию dks_poll в besm6_tty.c")

# Составные задачи разбивать на подзадачи:
#   «найди ошибку компиляции и исправь»
#   → builder: найти ошибки
#   → coder: исправить
#   → builder: пересобрать

## === АНТИ-ТАЙМАУТ: ЛИМИТЫ ПОРЦИЙ ===
# Причина: ошибка провайдера "The model did not respond in time"
# при сложных задачах и большом контексте.

# Правило T1: Один ход = один шаг
# За один ответ модели — максимум 3-4 инструментальных вызова.
# Сложные задачи ВСЕГДА сначала план, затем выполнение ПО ОДНОМУ шагу.

# Правило T2: Правка ≤ 100 строк за ход
# Большая правка разбивается:
#   "внеси только часть 1, остановись, покажи diff".

# Правило T3: /newtask после вехи
# После успешной сборки/завершённого этапа отладки — новая задача с summary.
# Долгие сессии (ДКС, трассы ОС) — не дольше ~40 ходов без /newtask.

# Правило T4: Волатильные данные — только командой, не в промпт
# Логи передавать командой (tail -50 debug.txt),
# НЕ вставляя содержимое файлов в текст запроса.

# Правило T5: Независимые куски — подагентам
# builder/coder/emulator/os-analyst получают узкую задачу
# со свежим контекстом (каждая подзадача тоже по T1).

# Правило T6: Чек-лист перед сложным запросом (АВТОМАТИЧЕСКИ)
# Перед задачей, требующей > 4 вызовов или правки > 100 строк,
# ПРИМЕНЯТЬ чек-лист: .cline/skills/small-portions.md
# (читать файл НЕ нужно — краткая версия: см. правило T1 и AGENTS.md разд. 16).

# Правило T7: После таймаута — резать запрос, не повторять (АВТОМАТИЧЕСКИ)
# При ошибке "The model did not respond in time":
#   1) НЕ повторять запрос целиком (повтор = тот же таймаут);
#   2) разделить задачу на 2-3 порции (T1/T2) и выполнить только первую;
#   3) если контекст сессии большой — сначала /newtask с summary;
#   4) один чистый ретрай допустим ТОЛЬКО при подозрении на разовую
#      нагрузку провайдера (запрос был коротким и лёгким).
