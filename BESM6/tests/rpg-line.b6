*NAME RPGLINE
*TRANS:FOREX3*,,411550
      PROGRAM RPGLINE
C     Geometry source for the RPG card-deck harness.  PRINT is the first
C     executable statement so the ACPU marker survives any later failure.
      INTEGER FRAME(64), X(4), Y(4), P(4), DX(4), DY(4), I, J
      COMMON /PDEVXY/ FRAME
      PRINT 900, 12345
  900 FORMAT(' 4 2 8 6 ', I5)
      X(1)=10
      Y(1)=10
      P(1)=0
      DX(1)=10
      DY(1)=10
      X(2)=20
      Y(2)=10
      P(2)=1
      DX(2)=8
      DY(2)=0
      X(3)=28
      Y(3)=10
      P(3)=1
      DX(3)=0
      DY(3)=6
      X(4)=28
      Y(4)=16
      P(4)=2
      DX(4)=-6
      DY(4)=0
      DO 20 J = 1, 4
         DO 10 I = 1, 64
   10    FRAME(I) = 0
         FRAME(1) = X(J)
         FRAME(2) = Y(J)
         FRAME(3) = P(J)
   20 CONTINUE
      END
*EXECUTE
*END FILE
``````
