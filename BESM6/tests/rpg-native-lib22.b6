      PROGRAM RPGNLIB
C     Diagnostic twin of rpg-native-line.b6 without the generation
C     card, so the library 22 chain can be observed past card checking.
      INTEGER N
      REAL X(2), Y(2)
      N = 2
      X(1) = 10.0
      Y(1) = 10.0
      X(2) = 110.0
      Y(2) = 110.0
      PRINT 900, 12345
  900 FORMAT(' 4 2 8 6 ', I5)
      CALL MOVE1(N, X, Y)
      END
*LIBRARY:22
*EXECUTE
*END FILE
